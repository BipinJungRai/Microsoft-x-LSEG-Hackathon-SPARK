# Copy to backend/.env and fill in. Never commit the real file.
# With USE_MOCKS=1 (the default) no keys are needed: the API serves fixed sample responses.
USE_MOCKS=1
FLASK_PORT=5070

# LLM (OpenAI-compatible endpoint). Set LLM_API_VERSION to use an Azure-style /openai/deployments/{model} route.
LLM_BASE_URL=https://your-llm-endpoint.example.com
LLM_API_KEY=your-api-key
LLM_MODEL=your-model-or-deployment-name
LLM_API_VERSION=
LLM_FAST_MODEL=
LLM_AUTH_HEADER=
LLM_MAX_TOKENS=2000
LLM_SEND_TEMPERATURE=0

# Alternative: your own Azure OpenAI resource (used only if LLM_BASE_URL is not set)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Optional: Azure Cosmos DB audit log. Leave empty to log to backend/data/local_store.jsonl
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=dontdoubledown

# Optional: FRED API key for scripts/download_prices.py (download_all.py needs none)
FRED_API_KEY=

RATE_LIMIT_PER_MIN=60

# Frontend (frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:5070
# NEXT_PUBLIC_DEMO_FALLBACK=1
